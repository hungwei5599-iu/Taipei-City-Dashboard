#!/usr/bin/env python3
"""Preflight check for the Gemini OAuth delegate wrapper."""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path


EXPECTED = "GEMINI_PREFLIGHT_OK_20260430"


def main() -> int:
    delegate = Path.home() / "bin" / "gemini-oauth-delegate"
    if not delegate.exists():
        delegate = Path(__file__).resolve().with_name("gemini-oauth-delegate")

    try:
        completed = subprocess.run(
            [str(delegate), f"Reply with exactly {EXPECTED}"],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            timeout=35,
            check=False,
        )
    except subprocess.TimeoutExpired as exc:
        output = (exc.stdout or "").strip()
        if output:
            print(output)
        print("STATUS: NOT_READY")
        return 1

    output = completed.stdout.strip()
    if completed.returncode != 0:
        if output:
            print(output)
        print("STATUS: NOT_READY")
        return 1

    if EXPECTED not in output:
        if output:
            print(output)
        print("STATUS: BAD_OUTPUT")
        return 2

    print("STATUS: READY")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
